# Copia este archivo a .env (NO se sube a Git) y cambia los valores marcados.

DB_NAME=soportehub_db
DB_USER=root
DB_PASSWORD=cambia-esto
POSTGRES_DB=soportehub_db
POSTGRES_USER=root
POSTGRES_PASSWORD=cambia-esto

# Dentro de Docker el host es el nombre del servicio. Si ejecutas la app desde el IDE, sobrescribe
# estas dos variables (ver README): DB_HOST=localhost DB_PORT=5433
DB_HOST=postgres
DB_PORT=5432

# --- Aplicación ---
PORT=8081
SPRING_PROFILES_ACTIVE=demo
APP_BASE_URL=http://localhost:8081
COOKIE_SECURE=false
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-texto-largo-de-al-menos-32-caracteres

# --- Correo (Resend). Sin clave, los correos no salen y el enlace de invitación aparece en el log ---
RESEND_API_KEY=
RESEND_FROM="SoporteHub <onboarding@resend.dev>"
